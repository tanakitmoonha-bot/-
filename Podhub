		local pos, ok, ordered = 1, true, true
		for _, p in ipairs(picks) do
			if not string.find(w, p, 1, true) then ok = false break end
		end
		if ok then
			for _, p in ipairs(picks) do
				local s, e = string.find(w, p, pos, true)
				if not s then ordered = false break end
				pos = e + 1
			end
			table.insert(ordered and inOrder or anyOrder, w)
		end
	end
	for _, w in ipairs(anyOrder) do table.insert(inOrder, w) end
	return inOrder
end

-- ==================== ระบบคัดลอกคลิปบอร์ด ====================
local Clipboard = {
	Enabled = true,
	ShowToast = true,
	ToastDuration = 1.5,
	AutoClear = false,
	ClearAfter = 30,
}

local function copyToClipboard(text)
	local ok, err = pcall(function()
		if setclipboard then
			setclipboard(text)
		elseif toclipboard then
			toclipboard(text)
		elseif writeclipboard then
			writeclipboard(text)
		else
			error("Executor นี้ไม่มีฟังก์ชัน clipboard")
		end
	end)
	return ok, err
end

