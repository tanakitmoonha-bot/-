-- ⭐ ฟังก์ชันคัดลอกข้อความลงคลิปบอร์ด
-- ใช้ setclipboard ของ executor (Synapse, Krnl, Fluxus, Delta, ฯลฯ)
local function copyToClipboard(text)
	local success, err = pcall(function()
		if setclipboard then
			setclipboard(text)
		elseif toclipboard then
			toclipboard(text)
		elseif writeclipboard then
			writeclipboard(text)
		else
			error("Executor นี้ไม่มีฟังก์ชัน clipboard")
		end
	end)
	return success, err
end

