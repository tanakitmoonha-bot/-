local WORDS, seen = {}, {}
local dupCount = 0

local function addWords(text)
	for w in string.gmatch(text, "%S+") do
		if not seen[w] then
			seen[w] = true
			table.insert(WORDS, w)
		else
			dupCount = dupCount + 1
		end
	end
end

addWords(WORDS_OLD)
