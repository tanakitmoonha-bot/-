addWords(WORDS_NEW)

-- ==================== ฟังก์ชันค้นหา ====================
local function search(picks)
	local inOrder, anyOrder = {}, {}
	for _, w in ipairs(WORDS) do
		local pos, ok, ordered = 1, true, true
		for _, p in ipairs(picks) do
			if not string.find(w, p, 1, true) then ok = false break end
		end
		if ok then
			for _, p in ipairs(picks) do
				local s, e = string.find(w, p, pos, true)
				if not s then ordered = false break end
				pos = e + 1
			end
			table.insert(ordered and inOrder or anyOrder, w)
		end
	end
	for _, w in ipairs(anyOrder) do table.insert(inOrder, w) end
	return inOrder
end

-- ==================== ⭐ ระบบพิมพ์ตามโฟกัส ====================
local AutoType = {
	Enabled = true,
	Delay = 0.15,
	Typing = false,
	Mode = "auto",  -- "auto" = ใช้ช่องที่โฟกัส / "chat" = บังคับลงแชท
	UseEnter = true,  -- กด Enter หลังพิมพ์หรือไม่
	ClearFirst = false,  -- ลบข้อความเก่าในช่องก่อนพิมพ์
}

-- ⭐ หา TextBox ที่กำลังโฟกัสอยู่ (รวมทั้ง PlayerGui, CoreGui, workspace)
local function findFocusedTextBox()
	local function scanGui(root)
		if not root then return nil end
		for _, obj in ipairs(root:GetDescendants()) do
			if obj:IsA("TextBox") and obj:IsFocused() and obj.Visible then
				return obj
			end
		end
		return nil
	end

	-- 1) PlayerGui
	local pg = LocalPlayer:FindFirstChild("PlayerGui")
	local found = scanGui(pg)
	if found then return found end

	-- 2) CoreGui (เช่น ช่องแชท)
	local coreFound = nil
	pcall(function()
		local cg = game:GetService("CoreGui")
		coreFound = scanGui(cg)
	end)
	if coreFound then return coreFound end

	-- 3) workspace (บางเกมมี TextBox ในโลก)
	return scanGui(workspace)
end

-- ⭐ ส่งคีย์ไปที่ TextBox ที่โฟกัสอยู่
local function typeIntoFocusedBox(text)
	local box = findFocusedTextBox()
	if not box then
		return false, "ไม่พบช่องที่โฟกัส"
	end

	-- ถ้าต้องการลบข้อความเก่า
	if AutoType.ClearFirst then
		box.Text = ""
		task.wait(0.05)
	end

	-- ใส่ข้อความ
	box.Text = text
	task.wait(0.05)

	-- ถ้าเปิด UseEnter และเป็นช่องแชท → กด Enter
	if AutoType.UseEnter then
		UserInputService:SendKeyEvent(Enum.KeyCode.Return, true)
		UserInputService:SendKeyEvent(Enum.KeyCode.Return, false)
	end

	return true, box
end

-- ⭐ ส่งลงแชท (ใช้เมื่อไม่มีช่องโฟกัส)
local function sendToChat(text)
	local TextChatService = game:GetService("TextChatService")
	if TextChatService.ChatVersion == Enum.ChatVersion.TextChatService then
		local channels = TextChatService:FindFirstChild("TextChannels")
		if channels then
			local general = channels:FindFirstChild("RBXGeneral")
			if general then
				general:SendAsync(text)
				return true
			end
		end
	end
	-- Legacy fallback
	local vu = game:GetService("VirtualUser")
	vu:CaptureController()
	UserInputService:SendKeyEvent(Enum.KeyCode.Slash, true)
	UserInputService:SendKeyEvent(Enum.KeyCode.Slash, false)
	task.wait(0.1)
	UserInputService:SendKeyEvent(Enum.KeyCode.Backspace, true)
	UserInputService:SendKeyEvent(Enum.KeyCode.Backspace, false)
	task.wait(0.1)
	-- หา chatBox
	local coreGui = game:GetService("CoreGui")
	local chatBox = nil
	pcall(function()
		local rg = coreGui:FindFirstChild("RobloxGui")
		if rg then
			local chat = rg:FindFirstChild("Chat")
			if chat then
				local bar = chat:FindFirstChild("ChatBar")
				if bar then
					chatBox = bar:FindFirstChildWhichIsA("TextBox", true)
				end
			end
		end
	end)
	if chatBox then
		chatBox.Text = text
		task.wait(0.05)
		UserInputService:SendKeyEvent(Enum.KeyCode.Return, true)
		UserInputService:SendKeyEvent(Enum.KeyCode.Return, false)
		return true
	end
	return false
end

-- ⭐ ฟังก์ชันหลัก — ตรวจโฟกัสแล้วพิมพ์ตรงนั้น
local function smartType(text)
	if AutoType.Typing then
		return false, "กำลังพิมพ์อยู่"
	end
	AutoType.Typing = true

	local ok, err = pcall(function()
		task.wait(AutoType.Delay)

		-- โหมด chat: บังคับลงแชทเสมอ
		if AutoType.Mode == "chat" then
			sendToChat(text)
			return
		end

		-- โหมด auto: ตรวจช่องโฟกัสก่อน
		local box = findFocusedTextBox()
		if box then
			-- มีช่องโฟกัส → พิมพ์ตรงนั้น
			typeIntoFocusedBox(text)
		else
			-- ไม่มีช่องโฟกัส → ส่งลงแชท
			sendToChat(text)
		end
	end)

	AutoType.Typing = false
	if not ok then
		warn("[AutoType] ผิดพลาด: " .. tostring(err))
		return false, tostring(err)
	end
	return true
end

