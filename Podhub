local picks, buttons = {}, {}

local function createWordButton(parent, word, order)
	local btn = Instance.new("TextButton")
	btn.Size = UDim2.new(1, -8, 0, 34)
	btn.BackgroundColor3 = C.word
	btn.Text = word
	btn.TextSize = 18
	btn.Font = Enum.Font.SourceSans
	btn.TextColor3 = C.text
	btn.TextXAlignment = Enum.TextXAlignment.Left
	btn.LayoutOrder = order
	btn.AutoButtonColor = false
	corner(btn, 8)

	local pad = Instance.new("UIPadding", btn)
	pad.PaddingLeft = UDim.new(0, 10)

	local copyIcon = label(btn, {
		Size = UDim2.fromOffset(30, 34),
		Position = UDim2.new(1, -34, 0, 0),
		Text = "📋", TextSize = 18,
		TextXAlignment = Enum.TextXAlignment.Center,
		TextTransparency = 0.3,
	})

	btn.MouseEnter:Connect(function() btn.BackgroundColor3 = C.wordHover end)
	btn.MouseLeave:Connect(function() btn.BackgroundColor3 = C.word end)

	btn.Activated:Connect(function()
		if not Clipboard.Enabled then
			Rayfield:Notify({ Title = "⚠️ ปิดอยู่", Content = "เปิดระบบคัดลอกในแท็บก่อน", Duration = 2 })
			return
		end

		local ok, err = copyToClipboard(word)
		if ok then
			showToast(word)
			btn.BackgroundColor3 = C.copied
			copyIcon.Text = "✓"
			copyIcon.TextTransparency = 0
			copyIcon.TextColor3 = Color3.fromRGB(255, 255, 255)

			task.delay(0.6, function()
				btn.BackgroundColor3 = C.word
				copyIcon.Text = "📋"
				copyIcon.TextTransparency = 0.3
				copyIcon.TextColor3 = C.text
			end)

			status.Text = "✅ คัดลอกแล้ว — ไปวางเองในช่อง"

			if Clipboard.AutoClear then
				task.delay(Clipboard.ClearAfter, function() copyToClipboard("") end)
			end
		else
			Rayfield:Notify({ Title = "❌ คัดลอกไม่สำเร็จ", Content = tostring(err or "Executor ไม่รองรับ clipboard"), Duration = 3 })
		end
	end)

	btn.Parent = parent
	return btn
end

local function refresh()
	for _, ch in ipairs(results:GetChildren()) do
		if ch:IsA("TextButton") then ch:Destroy() end
	end
	for letter, btn in pairs(buttons) do
		btn.BackgroundColor3 = table.find(picks, letter) and C.on or C.btn
	end
	if #picks == 0 then
		picked.Text = "-"
		status.Text = "แตะตัวอักษรเพื่อเริ่ม"
		return
	end
	picked.Text = table.concat(picks, " + ")
	if #picks < 2 then
		status.Text = "เลือกอีกอย่างน้อย 1 ตัว"
		return
	end
	local found = search(picks)
	status.Text = #found > 0 and ("พบ " .. #found .. " คำ (แตะเพื่อคัดลอก)") or "ไม่พบคำ"
	for i, w in ipairs(found) do
		createWordButton(results, w, i)
	end
end

