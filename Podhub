	btn.TextColor3 = C.text
	btn.BackgroundColor3 = C.btn
	btn.Parent = scroll
	corner(btn, 8)
	buttons[letter] = btn

	btn.Activated:Connect(function()
		local idx = table.find(picks, letter)
		if idx then
			table.remove(picks, idx)
		else
			if #picks >= MAX_PICK then table.remove(picks, 1) end
			table.insert(picks, letter)
		end
		refresh()
	end)
end

clear.Activated:Connect(function()
	table.clear(picks)
	refresh()
end)

