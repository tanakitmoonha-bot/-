local function showToast(word)
	if not Clipboard.ShowToast then return end
	if toastTween then toastTween:Cancel() end
	if toastTask then task.cancel(toastTask) end

	toastWord.Text = word
	toast.Visible = true
	toast.BackgroundTransparency = 1
	toastStroke.Transparency = 1
	toast.Position = UDim2.new(0.5, 0, 1, 20)

	toastTween = TweenService:Create(toast,
		TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
		{ Position = UDim2.new(0.5, 0, 1, -30), BackgroundTransparency = 0.1 })
	toastTween:Play()
	TweenService:Create(toastStroke, TweenInfo.new(0.3), { Transparency = 0 }):Play()

	toastTask = task.delay(Clipboard.ToastDuration, function()
		local fadeOut = TweenService:Create(toast, TweenInfo.new(0.3),
			{ Position = UDim2.new(0.5, 0, 1, 20), BackgroundTransparency = 1 })
		fadeOut:Play()
		TweenService:Create(toastStroke, TweenInfo.new(0.3), { Transparency = 1 }):Play()
		fadeOut.Completed:Connect(function() toast.Visible = false end)
	end)
end
