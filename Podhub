local picks, buttons = {}, {}

local function createWordButton(parent, word, order)
	local btn = Instance.new("TextButton")
	btn.Size = UDim2.new(1, -8, 0, 28)
	btn.BackgroundColor3 = C.word
	btn.Text = word
	btn.TextSize = 17
	btn.Font = Enum.Font.SourceSans
	btn.TextColor3 = C.text
	btn.TextXAlignment = Enum.TextXAlignment.Left
	btn.LayoutOrder = order
	btn.AutoButtonColor = false
	corner(btn, 6)
	local pad = Instance.new("UIPadding", btn)
	pad.PaddingLeft = UDim.new(0, 8)

	btn.MouseEnter:Connect(function() btn.BackgroundColor3 = C.wordHover end)
	btn.MouseLeave:Connect(function() btn.BackgroundColor3 = C.word end)

	btn.Activated:Connect(function()
		if not AutoType.Enabled then
			Rayfield:Notify({ Title = "⚠️ ปิดอยู่", Content = "เปิดระบบในแท็บ Auto Type ก่อน", Duration = 2 })
			return
		end
		if AutoType.Typing then
			Rayfield:Notify({ Title = "⏳ รอสักครู่", Content = "กำลังพิมพ์อยู่...", Duration = 1 })
			return
		end

		-- ⭐ ตรวจว่ามีช่องโฟกัสอยู่ไหม
		local box = findFocusedTextBox()
		local target = box and ("📝 " .. (box.Name or "TextBox")) or "💬 แชท"
		status.Text = "📤 กำลังพิมพ์ [" .. target .. "]: " .. word

		smartType(word)

		task.delay(0.8, function()
			if not AutoType.Typing then
				status.Text = #picks > 0 and ("แตะคำเพื่อพิมพ์ · " .. #picks .. "/" .. MAX_PICK .. " ตัว") or "แตะคำเพื่อพิมพ์"
			end
		end)
	end)

	btn.Parent = parent
	return btn
end

local function refresh()
	for _, ch in ipairs(results:GetChildren()) do
		if ch:IsA("TextButton") then ch:Destroy() end
	end
	for letter, btn in pairs(buttons) do
		btn.BackgroundColor3 = table.find(picks, letter) and C.on or C.btn
	end
	if #picks == 0 then
		picked.Text = "-"
		status.Text = "แตะตัวอักษรทางซ้าย"
		return
	end
	picked.Text = table.concat(picks, " + ")
	if #picks < 2 then
		status.Text = "เลือกอีกอย่างน้อย 1 ตัว"
		return
	end
	local found = search(picks)
	status.Text = #found > 0 and ("พบ " .. #found .. " คำ (แตะเพื่อพิมพ์)") or "ไม่พบคำ"
	for i, w in ipairs(found) do
		createWordButton(results, w, i)
	end
end

for _, letter in ipairs(LETTERS) do
	local btn = Instance.new("TextButton")
	btn.Text = letter
	btn.TextSize = 22
	btn.Font = Enum.Font.SourceSansBold
	btn.TextColor3 = C.text
	btn.BackgroundColor3 = C.btn
	btn.Parent = scroll
	corner(btn, 8)
	buttons[letter] = btn

	btn.Activated:Connect(function()
		local idx = table.find(picks, letter)
		if idx then
			table.remove(picks, idx)
		else
			if #picks >= MAX_PICK then table.remove(picks, 1) end
			table.insert(picks, letter)
		end
		refresh()
	end)
end

clear.Activated:Connect(function()
	table.clear(picks)
	refresh()
end)

local function makeDraggable(frame, handle)
	local dragging, dragStart, startPos = false, nil, nil
	handle.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			dragStart = input.Position
			startPos = frame.Position
		end
	end)
	handle.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			dragging = false
		end
	end)
	UserInputService.InputChanged:Connect(function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
			or input.UserInputType == Enum.UserInputType.Touch) then
			local delta = input.Position - dragStart
			frame.Position = UDim2.new(
				startPos.X.Scale, startPos.X.Offset + delta.X,
				startPos.Y.Scale, startPos.Y.Offset + delta.Y
			)
		end
	end)
end
